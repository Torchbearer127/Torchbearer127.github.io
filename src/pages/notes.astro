---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalizedContent from '../components/LocalizedContent.astro';
---

<BaseLayout
	title="Notes — 执炬人"
	description="执炬人关于 Agent 系统、软件安全、Agent Security 与程序分析的研究笔记。"
>
	<div class="page-shell">
		<header class="page-intro">
			<p class="page-eyebrow"><LocalizedContent id="notes-route-label" values={{ en: 'Compatibility route', 'zh-CN': '兼容入口', de: 'Kompatibilitätsroute' }} /></p>
			<h1 class="page-title"><LocalizedContent id="notes-route-title" values={{ en: 'Notes', 'zh-CN': '笔记', de: 'Notizen' }} /></h1>
			<p class="page-description"><LocalizedContent id="notes-route-description" values={{ en: 'Research Notes now belong to the unified Writing stream.', 'zh-CN': '研究笔记现已归入统一的写作流。', de: 'Forschungsnotizen gehören nun zum einheitlichen Textbereich.' }} /></p>
		</header>
		<div class="archive-empty">
			<p><a href="/writing/research-notes"><LocalizedContent id="notes-route-link" values={{ en: 'Continue to Research Notes', 'zh-CN': '前往研究笔记', de: 'Weiter zu den Forschungsnotizen' }} /> <span aria-hidden="true">→</span></a></p>
		</div>
	</div>
</BaseLayout>
