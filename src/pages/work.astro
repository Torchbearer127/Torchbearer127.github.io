---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalizedContent from '../components/LocalizedContent.astro';
import { workContent } from '../data/site-content.ts';
---

<BaseLayout
	title="Work — 执炬人"
	description="Current directions, selected work, and publications by Torchbearer127."
	localizedTitle={{ 'zh-CN': '工作 — 执炬人', de: 'Arbeit — Torchbearer127' }}
	localizedDescription={{ 'zh-CN': '执炬人的研究方向、工程工作与公开成果概览。', de: 'Aktuelle Richtungen, ausgewählte Arbeiten und Publikationen von Torchbearer127.' }}
>
	<div class="page-shell">
		<header class="page-intro">
			<p class="page-eyebrow"><LocalizedContent id="work-eyebrow" values={workContent.eyebrow} /></p>
			<h1 class="page-title"><LocalizedContent id="work-title" values={workContent.title} /></h1>
			<p class="page-description">
				<LocalizedContent id="work-description" values={workContent.description} />
			</p>
		</header>

		<div class="work-sections">
			{workContent.sections.map((section) => (
				<section class="work-section" aria-labelledby={section.id}>
					<h2 id={section.id}><LocalizedContent id={`work-${section.id}-title`} values={section.title} /></h2>
					<p><LocalizedContent id={`work-${section.id}-description`} values={section.description} /></p>
				</section>
			))}
		</div>
	</div>
</BaseLayout>

<style>
	.work-sections {
		max-width: var(--layout-prose-max);
		margin-top: clamp(3.5rem, 8vw, 5.5rem);
		border-top: 1px solid var(--color-border-subtle);
	}

	.work-section {
		padding-block: clamp(1.75rem, 4vw, 2.5rem);
		border-bottom: 1px solid var(--color-border-subtle);
		display: grid;
		gap: var(--space-3);
	}

	.work-section h2,
	.work-section p {
		margin: 0;
	}

	.work-section h2 {
		font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
		font-weight: 680;
		letter-spacing: -0.02em;
	}

	.work-section p {
		max-width: 38rem;
		color: var(--color-text-muted);
	}
</style>
