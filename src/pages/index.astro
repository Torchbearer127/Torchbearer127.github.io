---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroField from '../components/effects/HeroField.astro';
import SectionField from '../components/effects/SectionField.astro';
import HomeHero from '../components/home/HomeHero.astro';
import WritingList from '../components/writing/WritingList.astro';
import LocalizedContent from '../components/LocalizedContent.astro';
import { homeSections as sections } from '../data/site-content.ts';
import { getPublishedWriting } from '../lib/writing';

const latestWriting = await getPublishedWriting({ limit: 3 });

---

<BaseLayout
	title="Torchbearer127 — Agent Systems × Cyberspace Security"
	description="The personal digital space of Torchbearer127."
	localizedTitle={{ 'zh-CN': '执炬人 — 智能体系统 × 网络空间安全', de: 'Torchbearer127 — Agentensysteme × Cyberspace-Sicherheit' }}
	localizedDescription={{ 'zh-CN': '执炬人 / Torchbearer127 的个人数字空间。', de: 'Der persönliche digitale Raum von Torchbearer127.' }}
>
	<div class="home-shell">
		<div class="hero-stage" data-hero-stage data-field-surface>
			<HeroField />
			<HomeHero />
		</div>

		<div class="home-sections">
			{sections.map((section) => (
				<section
					class="content-section"
					aria-labelledby={section.id}
					data-field-surface
				>
					<SectionField variant={section.fieldVariant} seed={section.fieldSeed} />
					<div class="section-heading">
						<h2 id={section.id}><LocalizedContent id={`home-${section.id}-title`} values={section.title} /></h2>
						<a href={section.href}><LocalizedContent id={`home-${section.id}-link`} values={section.linkLabel} /> <span aria-hidden="true">→</span></a>
					</div>
					{section.id === 'latest-writing' && latestWriting.length ? (
						<WritingList entries={latestWriting} variant="mixed" />
					) : (
						<div class="empty-row">
							<p class="empty-row__title"><LocalizedContent id={`home-${section.id}-empty-title`} values={section.emptyTitle} /></p>
							<p><LocalizedContent id={`home-${section.id}-empty-description`} values={section.emptyDescription} /></p>
						</div>
					)}
				</section>
			))}
		</div>
	</div>
</BaseLayout>

<style>
	.home-shell {
		width: min(100%, var(--layout-page-max));
		margin-inline: auto;
		padding-right: max(var(--layout-gutter), env(safe-area-inset-right));
		padding-left: max(var(--layout-gutter), env(safe-area-inset-left));
	}

	.home-sections {
		padding-bottom: var(--section-gap);
	}

	.hero-stage {
		position: relative;
		isolation: isolate;
	}

	.content-section {
		position: relative;
		isolation: isolate;
		padding-block: clamp(2.75rem, 6vw, 4.5rem);
		border-top: 1px solid var(--color-border-subtle);
	}

	:global(:root[data-theme="light"]) .content-section {
		position: relative;
	}

	:global(:root[data-theme="light"]) .content-section::before {
		content: "";
		position: absolute;
		inset-block-start: -1px;
		inset-inline-start: 0;
		width: clamp(2rem, 4vw, 3rem);
		height: 2px;
		background: var(--color-accent);
	}

	.section-heading {
		position: relative;
		z-index: 1;
		margin-bottom: var(--space-6);
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-6);
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(1.5rem, 1.3rem + 0.7vw, 1.875rem);
		font-weight: 680;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	.section-heading a {
		flex: 0 0 auto;
		min-height: 2.5rem;
		display: inline-flex;
		align-items: center;
		color: var(--color-accent);
		font-size: 0.875rem;
	}

	.empty-row {
		position: relative;
		z-index: 1;
		padding-block: var(--space-6);
		border-block: 1px solid var(--color-border-subtle);
		display: grid;
		gap: var(--space-2);
	}

	.empty-row p {
		max-width: 40rem;
		margin: 0;
		color: var(--color-text-muted);
	}

	.empty-row .empty-row__title {
		color: var(--color-text-strong);
		font-size: 1.0625rem;
		font-weight: 620;
	}

	@media (max-width: 30rem) {
		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: var(--space-2);
		}
	}

	@media (hover: hover) {
		.section-heading a:hover {
			color: var(--color-accent-hover);
		}
	}
</style>
