---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';

const sections = [
	{
		id: 'latest-writing',
		title: 'Latest Writing',
		emptyTitle: 'No essays published yet.',
		emptyDescription: 'Long-form work will appear here when it is ready.',
		href: '/writing',
		linkLabel: 'Browse Writing',
	},
	{
		id: 'recent-notes',
		title: 'Recent Notes',
		emptyTitle: 'No notes published yet.',
		emptyDescription: 'Research notes and working observations will collect here.',
		href: '/notes',
		linkLabel: 'Browse Notes',
	},
	{
		id: 'selected-projects',
		title: 'Selected Projects',
		emptyTitle: 'Project notes are being prepared.',
		emptyDescription: 'Selected tools and experiments will be documented with their context intact.',
		href: '/projects',
		linkLabel: 'Browse Projects',
	},
];
---

<BaseLayout>
	<div class="home-shell">
		<HomeHero />

		<div class="home-sections">
			{sections.map((section) => (
				<section class="content-section" aria-labelledby={section.id}>
					<div class="section-heading">
						<h2 id={section.id}>{section.title}</h2>
						<a href={section.href}>{section.linkLabel} <span aria-hidden="true">→</span></a>
					</div>
					<div class="empty-row">
						<p class="empty-row__title">{section.emptyTitle}</p>
						<p>{section.emptyDescription}</p>
					</div>
				</section>
			))}
		</div>
	</div>
</BaseLayout>

<style>
	.home-shell {
		width: min(100%, var(--layout-page-max));
		margin-inline: auto;
		padding-right: max(var(--layout-gutter), env(safe-area-inset-right));
		padding-left: max(var(--layout-gutter), env(safe-area-inset-left));
	}

	.home-sections {
		padding-bottom: var(--section-gap);
	}

	.content-section {
		padding-block: clamp(2.75rem, 6vw, 4.5rem);
		border-top: 1px solid var(--color-border-subtle);
	}

	:global(:root[data-theme="light"]) .content-section {
		position: relative;
	}

	:global(:root[data-theme="light"]) .content-section::before {
		content: "";
		position: absolute;
		inset-block-start: -1px;
		inset-inline-start: 0;
		width: clamp(2rem, 4vw, 3rem);
		height: 2px;
		background: var(--color-accent);
	}

	.section-heading {
		margin-bottom: var(--space-6);
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-6);
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(1.5rem, 1.3rem + 0.7vw, 1.875rem);
		font-weight: 680;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	.section-heading a {
		flex: 0 0 auto;
		min-height: 2.5rem;
		display: inline-flex;
		align-items: center;
		color: var(--color-accent);
		font-size: 0.875rem;
	}

	.empty-row {
		padding-block: var(--space-6);
		border-block: 1px solid var(--color-border-subtle);
		display: grid;
		gap: var(--space-2);
	}

	.empty-row p {
		max-width: 40rem;
		margin: 0;
		color: var(--color-text-muted);
	}

	.empty-row .empty-row__title {
		color: var(--color-text-strong);
		font-size: 1.0625rem;
		font-weight: 620;
	}

	@media (max-width: 30rem) {
		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: var(--space-2);
		}
	}

	@media (hover: hover) {
		.section-heading a:hover {
			color: var(--color-accent-hover);
		}
	}
</style>
