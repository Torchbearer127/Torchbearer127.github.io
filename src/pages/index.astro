---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
	{
		id: 'latest-writing',
		title: 'Latest Writing',
		emptyTitle: 'No essays published yet.',
		emptyDescription: 'Long-form work will appear here when it is ready.',
		href: '/writing',
		linkLabel: 'Browse Writing',
	},
	{
		id: 'recent-notes',
		title: 'Recent Notes',
		emptyTitle: 'No notes published yet.',
		emptyDescription: 'Research notes and working observations will collect here.',
		href: '/notes',
		linkLabel: 'Browse Notes',
	},
	{
		id: 'selected-projects',
		title: 'Selected Projects',
		emptyTitle: 'Project notes are being prepared.',
		emptyDescription: 'Selected tools and experiments will be documented with their context intact.',
		href: '/projects',
		linkLabel: 'Browse Projects',
	},
];
---

<BaseLayout>
	<div class="home-shell">
		<section class="hero" aria-labelledby="identity-title">
			<p class="hero-kicker">Software Security · AI4Sec · Program Analysis</p>
			<h1 id="identity-title">执炬人</h1>
			<p class="hero-alias">
				<span class="hero-alias__mark" aria-hidden="true"></span>
				<span translate="no">Torchbearer127</span>
			</p>
			<p class="hero-statement">
				I study systems, vulnerabilities, and the paths hiding behind their assumptions.
			</p>
		</section>

		<div class="home-sections">
			{sections.map((section) => (
				<section class="content-section" aria-labelledby={section.id}>
					<div class="section-heading">
						<h2 id={section.id}>{section.title}</h2>
						<a href={section.href}>{section.linkLabel} <span aria-hidden="true">→</span></a>
					</div>
					<div class="empty-row">
						<p class="empty-row__title">{section.emptyTitle}</p>
						<p>{section.emptyDescription}</p>
					</div>
				</section>
			))}
		</div>
	</div>
</BaseLayout>

<style>
	.home-shell {
		width: min(100%, var(--layout-page-max));
		margin-inline: auto;
		padding-right: max(var(--layout-gutter), env(safe-area-inset-right));
		padding-left: max(var(--layout-gutter), env(safe-area-inset-left));
	}

	.hero {
		max-width: 52rem;
		padding-block: 4rem 3rem;
	}

	.hero-kicker {
		margin: 0 0 var(--space-6);
		color: var(--color-text-muted);
		font-size: 0.8125rem;
		font-weight: 650;
		letter-spacing: 0.065em;
		text-transform: uppercase;
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(3.5rem, 7vw, 5.25rem);
		font-weight: 680;
		letter-spacing: -0.035em;
		line-height: 1.02;
	}

	.hero-alias {
		margin: var(--space-4) 0 0;
		display: flex;
		align-items: center;
		gap: var(--space-3);
		color: var(--color-text-strong);
		font-size: 1rem;
		font-weight: 600;
	}

	.hero-alias__mark {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--color-ember);
	}

	.hero-statement {
		max-width: 38rem;
		margin: var(--space-8) 0 0;
		color: var(--color-text-muted);
		font-size: clamp(1.125rem, 1rem + 0.35vw, 1.3125rem);
		line-height: 1.65;
	}

	.home-sections {
		padding-bottom: var(--section-gap);
	}

	.content-section {
		padding-block: clamp(2.75rem, 6vw, 4.5rem);
		border-top: 1px solid var(--color-border-subtle);
	}

	.section-heading {
		margin-bottom: var(--space-6);
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-6);
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(1.5rem, 1.3rem + 0.7vw, 1.875rem);
		font-weight: 680;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	.section-heading a {
		flex: 0 0 auto;
		min-height: 2.5rem;
		display: inline-flex;
		align-items: center;
		color: var(--color-accent);
		font-size: 0.875rem;
	}

	.empty-row {
		padding-block: var(--space-6);
		border-block: 1px solid var(--color-border-subtle);
		display: grid;
		gap: var(--space-2);
	}

	.empty-row p {
		max-width: 40rem;
		margin: 0;
		color: var(--color-text-muted);
	}

	.empty-row .empty-row__title {
		color: var(--color-text-strong);
		font-size: 1.0625rem;
		font-weight: 620;
	}

	@media (min-width: 48rem) {
		.hero {
			padding-block: 6rem 4.5rem;
		}
	}

	@media (max-width: 30rem) {
		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: var(--space-2);
		}
	}

	@media (hover: hover) {
		.section-heading a:hover {
			color: var(--color-accent-hover);
		}
	}
</style>
