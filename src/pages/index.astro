---
import BaseLayout from '../layouts/BaseLayout.astro';

const topics = [
	'Vulnerability Discovery',
	'Program Analysis',
	'AI for Software Security',
	'Exploitability Validation',
];
---

<BaseLayout>
	<div class="home-shell">
		<section class="hero" aria-labelledby="identity-title">
			<div class="hero-identity">
				<p class="hero-kicker">Security · Research · Code · Thoughts</p>
				<h1 id="identity-title">执炬人</h1>
				<p class="hero-alias" translate="no">Torchbearer127</p>
			</div>

			<div class="hero-statement">
				<span class="statement-mark" aria-hidden="true"></span>
				<p>“I study systems, vulnerabilities, and the paths hiding behind their assumptions.”</p>
			</div>
		</section>

		<section class="content-section" aria-labelledby="thinking-title">
			<div class="section-heading">
				<p class="section-index" aria-hidden="true">01</p>
				<h2 id="thinking-title">Currently Thinking About</h2>
			</div>
			<ul class="topic-list">
				{topics.map((topic, index) => (
					<li>
						<span>{topic}</span>
						<span class="topic-number" aria-hidden="true">0{index + 1}</span>
					</li>
				))}
			</ul>
		</section>

		<section class="content-section" aria-labelledby="writing-title">
			<div class="section-heading">
				<p class="section-index" aria-hidden="true">02</p>
				<h2 id="writing-title">Selected Writing</h2>
			</div>
			<div class="quiet-state">
				<p>No essays published yet.</p>
				<p>The archive will open when the first piece is ready.</p>
				<a href="/writing">Visit Writing</a>
			</div>
		</section>

		<section class="content-section" aria-labelledby="projects-title">
			<div class="section-heading">
				<p class="section-index" aria-hidden="true">03</p>
				<h2 id="projects-title">Selected Projects</h2>
			</div>
			<div class="quiet-state">
				<p>Project notes are being prepared.</p>
				<p>This space will hold selected tools and experiments with their context intact.</p>
				<a href="/projects">Visit Projects</a>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.home-shell {
		width: min(100%, var(--page-width));
		margin-inline: auto;
		padding-right: max(var(--page-gutter), env(safe-area-inset-right));
		padding-left: max(var(--page-gutter), env(safe-area-inset-left));
	}

	.hero {
		min-height: min(48rem, calc(100svh - 8rem));
		padding-block: clamp(5rem, 12vw, 10rem) var(--space-24);
		display: grid;
		align-content: center;
		gap: var(--space-16);
	}

	.hero-identity {
		min-width: 0;
	}

	.hero-kicker {
		margin: 0 0 var(--space-6);
		color: var(--text-muted);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.hero h1 {
		margin: 0 0 var(--space-3) -0.055em;
		font-size: var(--text-display);
		letter-spacing: -0.07em;
		line-height: 0.88;
	}

	.hero-alias {
		margin: 0;
		color: var(--accent-strong);
		font-size: var(--text-sm);
		font-weight: 650;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.hero-statement {
		align-self: end;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: var(--space-4);
		max-width: 31rem;
		color: var(--text-muted);
		font-family: var(--font-display);
		font-size: var(--text-lead);
		font-style: italic;
		line-height: 1.55;
	}

	.hero-statement p {
		margin: 0;
	}

	.statement-mark {
		width: 1px;
		height: 3.5rem;
		margin-top: 0.35em;
		background: var(--accent);
	}

	.content-section {
		padding-block: clamp(4rem, 9vw, 7rem);
		border-top: 1px solid var(--border);
		display: grid;
		gap: var(--space-12);
	}

	.section-heading {
		display: grid;
		gap: var(--space-3);
		align-content: start;
	}

	.section-index {
		margin: 0;
		color: var(--accent-strong);
		font-size: var(--text-xs);
		font-variant-numeric: tabular-nums;
		font-weight: 700;
		letter-spacing: 0.15em;
	}

	.section-heading h2 {
		max-width: 13ch;
		margin: 0;
		font-size: var(--text-section);
		letter-spacing: -0.035em;
	}

	.topic-list {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
		list-style: none;
	}

	.topic-list li {
		min-height: 4.75rem;
		padding-block: var(--space-4);
		border-bottom: 1px solid var(--border);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
	}

	.topic-number {
		flex: 0 0 auto;
		color: var(--text-muted);
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.12em;
	}

	.quiet-state {
		padding-block: var(--space-6);
		border-block: 1px solid var(--border);
		display: grid;
		gap: var(--space-2);
		align-content: start;
	}

	.quiet-state p {
		max-width: 40rem;
		margin: 0;
		color: var(--text-muted);
	}

	.quiet-state p:first-child {
		color: var(--text);
		font-family: var(--font-display);
		font-size: 1.25rem;
	}

	.quiet-state a {
		width: fit-content;
		min-height: 2.75rem;
		margin-top: var(--space-4);
		display: inline-flex;
		align-items: center;
		color: var(--accent-strong);
		font-size: var(--text-sm);
		font-weight: 650;
	}

	.quiet-state a:hover {
		color: var(--text);
	}

	@media (min-width: 48rem) {
		.hero-kicker {
			font-size: var(--text-xs);
			letter-spacing: 0.14em;
		}

		.hero {
			grid-template-columns: minmax(0, 1.65fr) minmax(18rem, 0.7fr);
			align-items: end;
			gap: var(--space-16);
		}

		.content-section {
			grid-template-columns: minmax(12rem, 0.65fr) minmax(0, 1.5fr);
			gap: clamp(3rem, 8vw, 8rem);
		}
	}

	@media (min-width: 72rem) {
		.hero-statement {
			margin-bottom: var(--space-8);
		}
	}
</style>
