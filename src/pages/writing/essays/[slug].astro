---
import { render } from 'astro:content';
import EssayLayout from '../../../layouts/EssayLayout.astro';
import {
	getPublishedWriting,
	getWritingSlug,
	type WritingEntity,
} from '../../../lib/writing.ts';

export async function getStaticPaths() {
	const entities = await getPublishedWriting({ type: 'essay' });
	return entities.map((entity) => ({
		params: { slug: getWritingSlug(entity) },
		props: { entity },
	}));
}

interface Props {
	entity: WritingEntity;
}

const { entity } = Astro.props;
const variants = await Promise.all(entity.availableLocales.map(async (locale) => {
	const variant = entity.variants[locale]!;
	const { Content, headings } = await render(variant.entry);
	return { locale, Content, headings };
}));
---

<EssayLayout entity={entity} variants={variants} />
