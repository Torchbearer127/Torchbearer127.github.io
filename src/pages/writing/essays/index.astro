---
import WritingCollection from '../../../components/writing/WritingCollection.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedWriting } from '../../../lib/writing';

const entries = await getPublishedWriting({ type: 'essay' });
---

<BaseLayout
	title="Essays — Torchbearer127"
	description="Long-form reflections on research, engineering, and ways of thinking."
	localizedTitle={{ 'zh-CN': '随笔 — 执炬人', de: 'Essays — Torchbearer127' }}
	localizedDescription={{ 'zh-CN': '关于研究、工程与思考方式的长篇写作。', de: 'Lange Reflexionen über Forschung, Engineering und Denkweisen.' }}
>
	<WritingCollection
		title="Essays"
		description="Long-form reflections on research, engineering, and ways of thinking."
		type="essay"
		entries={entries}
	/>
</BaseLayout>
