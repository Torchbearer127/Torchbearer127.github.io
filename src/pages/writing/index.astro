---
import WritingList from '../../components/writing/WritingList.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedWriting } from '../../lib/writing';

const researchNotes = await getPublishedWriting({ type: 'research-note', limit: 3 });
const essays = await getPublishedWriting({ type: 'essay', limit: 3 });
---

<BaseLayout
	title="Writing — Torchbearer127"
	description="Research notes, technical writing, and essays by Torchbearer127."
	localizedTitle={{ 'zh-CN': '文字 — 执炬人', de: 'Texte — Torchbearer127' }}
	localizedDescription={{ 'zh-CN': '执炬人的研究札记、技术实证与沉思随笔。', de: 'Forschungsnotizen, technische Texte und Essays von Torchbearer127.' }}
>
	<div class="page-shell writing-hub">
		<header class="page-intro">
			<p class="page-eyebrow"><LocalizedText key="writing.eyebrow" /></p>
			<h1 class="page-title"><LocalizedText key="writing.title" /></h1>
			<p class="page-description">
				<LocalizedText key="writing.description" />
			</p>
		</header>

		<div class="writing-portals">
			<section class="writing-portal writing-portal--notes" aria-labelledby="research-notes-title">
				<div class="writing-portal__heading">
					<div>
						<p class="writing-portal__label"><LocalizedText key="writing.notes.label" /></p>
						<h2 id="research-notes-title"><LocalizedText key="writing.notes.title" /></h2>
					</div>
					<a href="/writing/research-notes"><LocalizedText key="writing.notes.explore" /> <span aria-hidden="true">→</span></a>
				</div>
				<p class="writing-portal__description">
					<LocalizedText key="writing.notes.description" />
				</p>
				{researchNotes.length ? (
					<WritingList entries={researchNotes} variant="research-note" />
				) : (
					<div class="portal-empty"><p><LocalizedText key="writing.notes.empty" /></p></div>
				)}
			</section>

			<section class="writing-portal writing-portal--essays" aria-labelledby="essays-title">
				<div class="writing-portal__heading">
					<div>
						<p class="writing-portal__label"><LocalizedText key="writing.essays.label" /></p>
						<h2 id="essays-title"><LocalizedText key="writing.essays.title" /></h2>
					</div>
					<a href="/writing/essays"><LocalizedText key="writing.essays.explore" /> <span aria-hidden="true">→</span></a>
				</div>
				<p class="writing-portal__description">
					<LocalizedText key="writing.essays.description" />
				</p>
				{essays.length ? (
					<WritingList entries={essays} variant="essay" />
				) : (
					<div class="portal-empty"><p><LocalizedText key="writing.essays.empty" /></p></div>
				)}
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	.writing-portals {
		margin-top: clamp(4rem, 9vw, 7rem);
		display: grid;
		gap: clamp(4rem, 9vw, 7rem);
	}

	.writing-portal {
		position: relative;
		max-width: var(--layout-prose-max);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border-subtle);
	}

	.writing-portal--notes::before {
		content: "";
		position: absolute;
		top: -1px;
		left: 0;
		width: 3rem;
		height: 2px;
		background: var(--color-accent);
	}

	.writing-portal__heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-6);
	}

	.writing-portal__label {
		margin: 0 0 var(--space-2);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.writing-portal h2 {
		margin: 0;
		font-size: clamp(1.75rem, 1.5rem + 0.8vw, 2.25rem);
		letter-spacing: -0.03em;
	}

	.writing-portal__heading a {
		min-height: 2.5rem;
		display: inline-flex;
		align-items: center;
		color: var(--color-accent);
		font-size: 0.875rem;
		white-space: nowrap;
	}

	.writing-portal__description {
		max-width: 38rem;
		margin: var(--space-5) 0 var(--space-8);
		color: var(--color-text-muted);
	}

	.portal-empty {
		padding-block: var(--space-6);
		border-block: 1px solid var(--color-border-subtle);
	}

	.portal-empty p {
		margin: 0;
		color: var(--color-text-muted);
	}

	@media (max-width: 35rem) {
		.writing-portal__heading {
			align-items: flex-start;
			flex-direction: column;
			gap: var(--space-3);
		}
	}

	@media (hover: hover) {
		.writing-portal__heading a:hover {
			color: var(--color-accent-hover);
		}
	}
</style>
