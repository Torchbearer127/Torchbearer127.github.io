---
import { render } from 'astro:content';
import ResearchNoteLayout from '../../../layouts/ResearchNoteLayout.astro';
import {
	getPublishedWriting,
	getWritingSlug,
	type WritingEntity,
} from '../../../lib/writing.ts';

export async function getStaticPaths() {
	const entities = await getPublishedWriting({ type: 'research-note' });
	return entities.map((entity) => ({
		params: { slug: getWritingSlug(entity) },
		props: { entity },
	}));
}

interface Props {
	entity: WritingEntity;
}

const { entity } = Astro.props;
const variants = await Promise.all(entity.availableLocales.map(async (locale) => {
	const { Content } = await render(entity.variants[locale]!.entry);
	return { locale, Content };
}));
---

<ResearchNoteLayout entity={entity} variants={variants} />
