---
import WritingCollection from '../../../components/writing/WritingCollection.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedWriting } from '../../../lib/writing';

const entries = await getPublishedWriting({ type: 'research-note' });
---

<BaseLayout
	title="Research Notes — Torchbearer127"
	description="Technical records from papers, experiments, implementations, and software security research."
	localizedTitle={{ 'zh-CN': '研究笔记 — 执炬人', de: 'Forschungsnotizen — Torchbearer127' }}
	localizedDescription={{ 'zh-CN': '来自论文、实验、实现与软件安全研究的技术记录。', de: 'Technische Aufzeichnungen aus Papern, Experimenten, Implementierungen und Softwaresicherheitsforschung.' }}
>
	<WritingCollection
		title="Research Notes"
		description="Fragments from papers, experiments, implementations, and security research."
		type="research-note"
		entries={entries}
	/>
</BaseLayout>
