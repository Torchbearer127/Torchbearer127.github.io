---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalizedContent from '../../components/LocalizedContent.astro';
import { aboutContent } from '../../data/site-content.ts';
---

<BaseLayout
	title="About — Torchbearer127"
	description="About Torchbearer127 and work across agent systems, cyberspace security, AI4Sec, and agent security."
	localizedTitle={{ 'zh-CN': '关于 — 执炬人', de: 'Über mich — Torchbearer127' }}
	localizedDescription={{ 'zh-CN': '关于执炬人 / Torchbearer127 在智能体系统、网络空间安全、AI4Sec 与智能体安全方向的工作。', de: 'Über Torchbearer127 und die Arbeit an Agentensystemen, Cyberspace-Sicherheit, AI4Sec und Agentensicherheit.' }}
>
	<div class="page-shell about-hub">
		<header class="page-intro" id="identity">
			<p class="page-eyebrow"><LocalizedContent id="about-eyebrow" values={aboutContent.eyebrow} /></p>
			<h1 class="page-title"><LocalizedContent id="about-title" values={aboutContent.title} /></h1>
			<p class="page-description">
				<LocalizedContent id="about-description" values={aboutContent.description} />
			</p>
		</header>

		<section class="research-focus" id="research" aria-labelledby="research-title">
			<h2 id="research-title"><LocalizedContent id="about-research-title" values={aboutContent.researchTitle} /></h2>
			<p class="section-intro">
				<LocalizedContent id="about-research-intro" values={aboutContent.researchIntro} />
			</p>

			<div class="focus-groups">
				{aboutContent.focusAreas.map((area) => (
					<section class="focus-group" aria-labelledby={area.id}>
						<h3 id={area.id}><LocalizedContent id={`about-${area.id}-title`} values={area.title} /></h3>
						<ul>
							{area.items.map((item, index) => <li><LocalizedContent id={`about-${area.id}-item-${index}`} values={item} /></li>)}
						</ul>
					</section>
				))}
			</div>
		</section>

		<section class="adjacent-interests" aria-labelledby="interests-title">
			<h2 id="interests-title"><LocalizedContent id="about-paths-title" values={aboutContent.pathsTitle} /></h2>
			<p class="section-intro"><LocalizedContent id="about-paths-intro" values={aboutContent.pathsIntro} /></p>
			<ul>
				{aboutContent.paths.map((interest, index) => <li><LocalizedContent id={`about-path-${index}`} values={interest} /></li>)}
			</ul>
		</section>

		<section class="about-preview about-preview--gallery" id="gallery" aria-labelledby="gallery-title">
			<div class="about-preview__heading">
				<h2 id="gallery-title"><LocalizedContent id="about-gallery-title" values={aboutContent.galleryTitle} /></h2>
				<a href="/about/gallery"><LocalizedContent id="about-gallery-explore" values={aboutContent.galleryExplore} /> <span aria-hidden="true">→</span></a>
			</div>
			<div class="gallery-preview" aria-hidden="true">
				<span></span><span></span><span></span>
			</div>
			<p><LocalizedContent id="about-gallery-description" values={aboutContent.galleryDescription} /></p>
		</section>

		<section class="about-preview about-preview--hall" id="hall-of-fame" aria-labelledby="hall-of-fame-title">
			<div class="about-preview__heading">
				<h2 id="hall-of-fame-title"><LocalizedContent id="about-hall-title" values={aboutContent.hallTitle} /></h2>
				<a href="/about/hall-of-fame"><LocalizedContent id="about-hall-explore" values={aboutContent.hallExplore} /> <span aria-hidden="true">→</span></a>
			</div>
			<p class="milestone-preview"><LocalizedContent id="about-hall-description" values={aboutContent.hallDescription} /></p>
		</section>

		<section class="elsewhere" id="elsewhere" aria-labelledby="elsewhere-title">
			<h2 id="elsewhere-title"><LocalizedContent id="about-elsewhere" values={aboutContent.elsewhere} /></h2>
			<p><a href="https://github.com/Torchbearer127" rel="me">GitHub <span aria-hidden="true">→</span></a></p>
		</section>
	</div>
</BaseLayout>

<style>
	.research-focus,
	.adjacent-interests,
	.about-preview,
	.elsewhere {
		max-width: var(--layout-prose-max);
		margin-top: clamp(3.5rem, 8vw, 5.5rem);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border-subtle);
	}

	.research-focus h2,
	.adjacent-interests h2,
	.about-preview h2,
	.elsewhere h2 {
		margin: 0;
		font-size: clamp(1.5rem, 1.35rem + 0.5vw, 1.875rem);
		font-weight: 680;
		letter-spacing: -0.025em;
	}

	.section-intro,
	.about-preview > p,
	.elsewhere > p {
		max-width: 38rem;
		margin: var(--space-4) 0 0;
		color: var(--color-text-muted);
	}

	.focus-groups,
	.adjacent-interests ul {
		margin: var(--space-8) 0 0;
		padding: 0;
		border-top: 1px solid var(--color-border-subtle);
	}

	.focus-group {
		padding-block: var(--space-6);
		border-bottom: 1px solid var(--color-border-subtle);
		display: grid;
		gap: var(--space-4);
	}

	.focus-group h3 {
		margin: 0;
		font-size: 1.0625rem;
		font-weight: 650;
		line-height: 1.45;
	}

	.focus-group ul,
	.adjacent-interests ul {
		list-style: none;
	}

	.focus-group ul {
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
	}

	.focus-group li,
	.adjacent-interests li {
		color: var(--color-text);
	}

	.adjacent-interests li {
		padding-block: var(--space-3);
		border-bottom: 1px solid var(--color-border-subtle);
		font-weight: 560;
	}

	.about-preview__heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-6);
	}

	.about-preview__heading a,
	.elsewhere a {
		color: var(--color-accent);
		font-size: 0.875rem;
	}

	.gallery-preview {
		margin-top: var(--space-6);
		display: grid;
		grid-template-columns: 1.2fr 0.8fr 1fr;
		gap: var(--space-2);
	}

	.gallery-preview span {
		min-height: clamp(4.5rem, 13vw, 7.5rem);
		border: 1px solid var(--color-border-subtle);
		background: var(--color-surface-subtle);
	}

	.gallery-preview span:nth-child(2) {
		transform: translateY(var(--space-4));
	}

	.milestone-preview {
		padding: var(--space-6) 0;
		border-bottom: 1px solid var(--color-border-subtle);
		font-size: 1.0625rem;
	}

	@media (min-width: 40rem) {
		.focus-group {
			grid-template-columns: minmax(11rem, 0.75fr) minmax(0, 1.25fr);
			gap: var(--space-8);
		}
	}

	@media (hover: hover) {
		.about-preview__heading a:hover,
		.elsewhere a:hover {
			color: var(--color-accent-hover);
		}
	}
</style>
