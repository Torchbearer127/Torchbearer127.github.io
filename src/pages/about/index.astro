---
import BaseLayout from '../../layouts/BaseLayout.astro';

const focusAreas = [
	{
		id: 'agent-systems',
		title: 'Agent Systems & Engineering',
		items: [
			'Agent Harnesses',
			'Tool Use and Orchestration',
			'Context and Evaluation',
			'Reliable Agent Workflows',
		],
	},
	{
		id: 'software-security',
		title: 'Software Security',
		items: ['Vulnerability Discovery', 'Program Analysis', 'Exploitability Validation'],
	},
	{
		id: 'ai4sec',
		title: 'AI4Sec & Agent Security — The Intersection',
		items: [
			'Agent Security',
			'AI-assisted Program Analysis',
			'Automated Vulnerability Reasoning',
			'Closed-loop Validation',
		],
	},
];

const adjacentInterests = [
	'Penetration Testing',
	'Algorithms & Data Structures',
	'Thoughts on Philosophy and Mind',
	'Essays, Prose, and Creative Writing',
	'Snowboarding & Fitness',
];
---

<BaseLayout
	title="About — 执炬人"
	description="关于执炬人 / Torchbearer127 在 Agent 系统、网络空间安全、AI4Sec 与 Agent Security 方向的工作。"
>
	<div class="page-shell about-hub">
		<header class="page-intro" id="identity">
			<p class="page-eyebrow">Identity</p>
			<h1 class="page-title">About</h1>
			<p class="page-description">
				A brief orientation to my work across agent systems and cyberspace security.
			</p>
		</header>

		<section class="research-focus" id="research" aria-labelledby="research-title">
			<h2 id="research-title">Research Interests</h2>
			<p class="section-intro">
				Agent systems and cyberspace security are the two primary axes of my work. AI4Sec
				and agent security are where these directions intersect.
			</p>

			<div class="focus-groups">
				{focusAreas.map((area) => (
					<section class="focus-group" aria-labelledby={area.id}>
						<h3 id={area.id}>{area.title}</h3>
						<ul>
							{area.items.map((item) => <li>{item}</li>)}
						</ul>
					</section>
				))}
			</div>
		</section>

		<section class="adjacent-interests" aria-labelledby="interests-title">
			<h2 id="interests-title">Forking Paths</h2>
			<p class="section-intro">Forking paths of curiosity—from auxiliary crafts to written thoughts and the open snow.</p>
			<ul>
				{adjacentInterests.map((interest) => <li>{interest}</li>)}
			</ul>
		</section>

		<section class="about-preview about-preview--gallery" id="gallery" aria-labelledby="gallery-title">
			<div class="about-preview__heading">
				<h2 id="gallery-title">Gallery</h2>
				<a href="/about/gallery">Explore Gallery <span aria-hidden="true">→</span></a>
			</div>
			<div class="gallery-preview" aria-hidden="true">
				<span></span><span></span><span></span>
			</div>
			<p>A curated collection of personal moments.</p>
		</section>

		<section class="about-preview about-preview--hall" id="hall-of-fame" aria-labelledby="hall-of-fame-title">
			<div class="about-preview__heading">
				<h2 id="hall-of-fame-title">Hall of Fame</h2>
				<a href="/about/hall-of-fame">View Hall <span aria-hidden="true">→</span></a>
			</div>
			<p class="milestone-preview">Selected milestones worth keeping on the wall.</p>
		</section>

		<section class="elsewhere" id="elsewhere" aria-labelledby="elsewhere-title">
			<h2 id="elsewhere-title">Elsewhere</h2>
			<p><a href="https://github.com/Torchbearer127" rel="me">GitHub <span aria-hidden="true">→</span></a></p>
		</section>
	</div>
</BaseLayout>

<style>
	.research-focus,
	.adjacent-interests,
	.about-preview,
	.elsewhere {
		max-width: var(--layout-prose-max);
		margin-top: clamp(3.5rem, 8vw, 5.5rem);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border-subtle);
	}

	.research-focus h2,
	.adjacent-interests h2,
	.about-preview h2,
	.elsewhere h2 {
		margin: 0;
		font-size: clamp(1.5rem, 1.35rem + 0.5vw, 1.875rem);
		font-weight: 680;
		letter-spacing: -0.025em;
	}

	.section-intro,
	.about-preview > p,
	.elsewhere > p {
		max-width: 38rem;
		margin: var(--space-4) 0 0;
		color: var(--color-text-muted);
	}

	.focus-groups,
	.adjacent-interests ul {
		margin: var(--space-8) 0 0;
		padding: 0;
		border-top: 1px solid var(--color-border-subtle);
	}

	.focus-group {
		padding-block: var(--space-6);
		border-bottom: 1px solid var(--color-border-subtle);
		display: grid;
		gap: var(--space-4);
	}

	.focus-group h3 {
		margin: 0;
		font-size: 1.0625rem;
		font-weight: 650;
		line-height: 1.45;
	}

	.focus-group ul,
	.adjacent-interests ul {
		list-style: none;
	}

	.focus-group ul {
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
	}

	.focus-group li,
	.adjacent-interests li {
		color: var(--color-text);
	}

	.adjacent-interests li {
		padding-block: var(--space-3);
		border-bottom: 1px solid var(--color-border-subtle);
		font-weight: 560;
	}

	.about-preview__heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-6);
	}

	.about-preview__heading a,
	.elsewhere a {
		color: var(--color-accent);
		font-size: 0.875rem;
	}

	.gallery-preview {
		margin-top: var(--space-6);
		display: grid;
		grid-template-columns: 1.2fr 0.8fr 1fr;
		gap: var(--space-2);
	}

	.gallery-preview span {
		min-height: clamp(4.5rem, 13vw, 7.5rem);
		border: 1px solid var(--color-border-subtle);
		background: var(--color-surface-subtle);
	}

	.gallery-preview span:nth-child(2) {
		transform: translateY(var(--space-4));
	}

	.milestone-preview {
		padding: var(--space-6) 0;
		border-bottom: 1px solid var(--color-border-subtle);
		font-size: 1.0625rem;
	}

	@media (min-width: 40rem) {
		.focus-group {
			grid-template-columns: minmax(11rem, 0.75fr) minmax(0, 1.25fr);
			gap: var(--space-8);
		}
	}

	@media (hover: hover) {
		.about-preview__heading a:hover,
		.elsewhere a:hover {
			color: var(--color-accent-hover);
		}
	}
</style>
