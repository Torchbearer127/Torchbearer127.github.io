---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalizedContent from '../../components/LocalizedContent.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import { collectionContent } from '../../data/site-content.ts';
---

<BaseLayout
	title="Gallery — Torchbearer127"
	description="A curated collection of personal moments and places."
	localizedTitle={{ 'zh-CN': '光影定格 — 执炬人', de: 'Galerie — Torchbearer127' }}
	localizedDescription={{ 'zh-CN': '执炬人克制凝固的时间切片与空间记忆。', de: 'Eine kuratierte Sammlung persönlicher Momente und Orte.' }}
>
	<div class="page-shell about-collection">
		<a class="context-link" href="/about"><span aria-hidden="true">←</span> <LocalizedText key="nav.about" /></a>
		<header class="page-intro">
			<p class="page-eyebrow"><LocalizedContent id="gallery-eyebrow" values={collectionContent.gallery.eyebrow} /></p>
			<h1 class="page-title"><LocalizedContent id="gallery-title" values={collectionContent.gallery.title} /></h1>
			<p class="page-description">
				<LocalizedContent id="gallery-description" values={collectionContent.gallery.description} />
			</p>
		</header>
		<div class="archive-empty gallery-empty">
			<p><LocalizedContent id="gallery-empty" values={collectionContent.gallery.empty} /></p>
		</div>
	</div>
</BaseLayout>

<style>
	.about-collection .page-intro {
		margin-top: var(--space-8);
	}

	.gallery-empty {
		min-height: 10rem;
		display: flex;
		align-items: end;
		background: var(--color-surface-subtle);
	}
</style>
