---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalizedContent from '../components/LocalizedContent.astro';
---

<BaseLayout
	title="Projects — 执炬人"
	description="执炬人在 Agent 系统、软件安全与 AI4Sec 方向的工具、实验和项目记录。"
>
	<div class="page-shell">
		<header class="page-intro">
			<p class="page-eyebrow"><LocalizedContent id="projects-route-label" values={{ en: 'Compatibility route', 'zh-CN': '兼容路由', de: 'Kompatibilitätsroute' }} /></p>
			<h1 class="page-title"><LocalizedContent id="projects-route-title" values={{ en: 'Projects', 'zh-CN': '项目', de: 'Projekte' }} /></h1>
			<p class="page-description"><LocalizedContent id="projects-route-description" values={{ en: 'Projects now belong to the broader Work overview.', 'zh-CN': '开源与工程项目现已整合至『实践』全景。', de: 'Projekte gehören nun zum umfassenderen Arbeitsüberblick.' }} /></p>
		</header>
		<div class="archive-empty">
			<p><a href="/work"><LocalizedContent id="projects-route-link" values={{ en: 'Continue to Work', 'zh-CN': '前往实践全景', de: 'Weiter zur Arbeit' }} /> <span aria-hidden="true">→</span></a></p>
		</div>
	</div>
</BaseLayout>
