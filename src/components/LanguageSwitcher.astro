---
import { message } from '../i18n/messages.ts';
import { SUPPORTED_LOCALES } from '../i18n/locales.ts';

const compactLocaleLabels = {
	'zh-CN': '中文',
	en: 'EN',
	de: 'DE',
} as const;
---

<label class="language-switcher" data-specular>
	<span class="visually-hidden" data-i18n="language.label">{message('en', 'language.label')}</span>
	<svg viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="8.5" />
		<path d="M3.8 12h16.4M12 3.5c2.2 2.3 3.3 5.2 3.3 8.5S14.2 18.2 12 20.5M12 3.5C9.8 5.8 8.7 8.7 8.7 12s1.1 6.2 3.3 8.5" />
	</svg>
	<select
		data-locale-switcher
		aria-label={message('en', 'language.label')}
		data-i18n-aria-label="language.label"
	>
		{SUPPORTED_LOCALES.map((locale) => (
			<option value={locale} selected={locale === 'en'}>{compactLocaleLabels[locale]}</option>
		))}
	</select>
</label>

<style>
	.language-switcher {
		position: relative;
		width: 6rem;
		height: 2.5rem;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		display: inline-flex;
		align-items: center;
		background: transparent;
		color: var(--color-text-muted);
	}

	.language-switcher svg {
		position: absolute;
		left: 0.55rem;
		width: 1rem;
		height: 1rem;
		fill: none;
		pointer-events: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 1.45;
	}

	.language-switcher select {
		width: 100%;
		height: 100%;
		padding: 0.35rem 1.15rem 0.35rem 1.7rem;
		border: 0;
		border-radius: inherit;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 600;
		cursor: pointer;
	}

	.language-switcher select:focus-visible {
		outline: var(--focus-width) solid var(--color-focus-ring);
		outline-offset: var(--focus-offset);
	}

	.language-switcher:focus-within::after {
		opacity: 0.72;
	}

	.language-switcher:has(select:active) {
		background: var(--color-surface-active);
	}

	@media (hover: hover) {
		.language-switcher:hover {
			border-color: var(--color-border-control);
			background: var(--color-accent-soft);
			color: var(--color-accent-hover);
		}
	}

	@media (max-width: 24rem) {
		.language-switcher svg {
			display: none;
		}

		.language-switcher select {
			width: 100%;
			padding-inline: 0.4rem 1.25rem;
		}
	}
</style>
