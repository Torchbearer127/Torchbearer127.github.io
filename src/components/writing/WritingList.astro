---
import {
	formatWritingDate,
	getWritingHref,
	noteKindLabels,
	resolveWritingVariant,
	writingTypeLabels,
	type WritingEntity,
} from '../../lib/writing';
import LocalizedText from '../LocalizedText.astro';

interface Props {
	entries: WritingEntity[];
	variant?: 'mixed' | 'research-note' | 'essay';
	rail?: boolean;
}

const { entries, variant = 'mixed', rail = false } = Astro.props;
---

<ol class:list={['writing-list', `writing-list--${variant}`, { 'writing-list--rail': rail }]}>
	{entries.map((entity) => {
		const noteKind = entity.data.noteKind ? noteKindLabels[entity.data.noteKind] : undefined;
		const typeLabel = noteKind ?? writingTypeLabels[entity.type];
		const defaultVariant = resolveWritingVariant(entity, 'en');
		const copies = entity.availableLocales.map((locale) => entity.variants[locale]!);
		const groupProps = {
			'data-content-group': entity.id,
			'data-available-locales': entity.availableLocales.join(','),
			'data-original-locale': entity.originalLocale,
		};

		return (
			<li>
				<article>
					<div class="writing-list__meta">
						<span class="writing-list__type">
							{noteKind ? typeLabel : <LocalizedText key={entity.type === 'essay' ? 'essay.type' : 'note.type'} />}
						</span>
						<time datetime={entity.data.date.toISOString()}>
							{entity.data.dateLabel ?? formatWritingDate(entity.data.date)}
						</time>
					</div>
					<h3>
						<a href={getWritingHref(entity)} {...groupProps} data-content-locale={defaultVariant.locale}>
							{copies.map((copy) => (
								<span data-content-copy={copy.locale} lang={copy.locale} hidden={copy.locale !== defaultVariant.locale}>
									{copy.title}
								</span>
							))}
						</a>
					</h3>
					<p {...groupProps} data-content-locale={defaultVariant.locale}>
						{copies.map((copy) => (
							<span data-content-copy={copy.locale} lang={copy.locale} hidden={copy.locale !== defaultVariant.locale}>
								{copy.description}
							</span>
						))}
					</p>
					{entity.data.tags?.length ? (
						<ul class="writing-list__tags" aria-label="Tags">
							{entity.data.tags.map((tag) => <li>{tag}</li>)}
						</ul>
					) : null}
				</article>
			</li>
		);
	})}
</ol>

<style>
	.writing-list {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border-subtle);
		list-style: none;
	}

	.writing-list > li {
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.writing-list article {
		padding-block: clamp(1.5rem, 3vw, 2rem);
		display: grid;
		gap: var(--space-3);
	}

	.writing-list__meta {
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.045em;
		text-transform: uppercase;
	}

	.writing-list__type {
		color: var(--color-accent);
		font-weight: 700;
	}

	.writing-list h3,
	.writing-list p {
		margin: 0;
	}

	.writing-list h3 {
		font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.625rem);
		line-height: 1.25;
	}

	.writing-list h3 a {
		text-decoration: none;
	}

	.writing-list p {
		max-width: 40rem;
		color: var(--color-text-muted);
	}

	.writing-list__tags {
		margin: var(--space-1) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		list-style: none;
	}

	.writing-list--essay .writing-list__type {
		color: var(--color-text-muted);
		font-family: var(--font-sans);
		font-weight: 650;
		letter-spacing: 0.06em;
	}

	.writing-list--essay h3 {
		font-size: clamp(1.375rem, 1.15rem + 0.7vw, 1.875rem);
	}

	.writing-list--rail {
		position: relative;
		margin-inline-start: 0.2rem;
		padding-inline-start: clamp(1rem, 3vw, 2rem);
		border-top: 0;
		border-inline-start: 1px solid var(--color-border-subtle);
	}

	.writing-list--rail::before {
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: -1px;
		width: 2px;
		height: 1.5rem;
		background: var(--color-accent);
		content: "";
	}

	.writing-list--rail > li {
		border-bottom: 0;
	}

	.writing-list--rail > li + li {
		border-top: 1px solid var(--color-border-subtle);
	}

	@media (max-width: 44rem) {
		.writing-list--rail {
			margin-inline-start: 0.05rem;
			padding-inline-start: 1rem;
		}
	}

	@media (hover: hover) {
		.writing-list h3 a:hover {
			color: var(--color-accent-hover);
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 0.28em;
		}
	}
</style>
