---
import {
	formatWritingDate,
	getWritingHref,
	noteKindLabels,
	writingTypeLabels,
	type WritingEntry,
} from '../../lib/writing';

interface Props {
	entries: WritingEntry[];
	variant?: 'mixed' | 'research-note' | 'essay';
}

const { entries, variant = 'mixed' } = Astro.props;
---

<ol class:list={['writing-list', `writing-list--${variant}`]}>
	{entries.map((entry) => {
		const noteKind = entry.data.noteKind ? noteKindLabels[entry.data.noteKind] : undefined;
		const typeLabel = noteKind ?? writingTypeLabels[entry.data.type];

		return (
			<li>
				<article>
					<div class="writing-list__meta">
						<span class="writing-list__type">{typeLabel}</span>
						<time datetime={entry.data.date.toISOString()}>
							{entry.data.dateLabel ?? formatWritingDate(entry.data.date)}
						</time>
					</div>
					<h3><a href={getWritingHref(entry)}>{entry.data.title}</a></h3>
					<p>{entry.data.description}</p>
					{entry.data.tags?.length ? (
						<ul class="writing-list__tags" aria-label="Tags">
							{entry.data.tags.map((tag) => <li>{tag}</li>)}
						</ul>
					) : null}
				</article>
			</li>
		);
	})}
</ol>

<style>
	.writing-list {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border-subtle);
		list-style: none;
	}

	.writing-list > li {
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.writing-list article {
		padding-block: clamp(1.5rem, 3vw, 2rem);
		display: grid;
		gap: var(--space-3);
	}

	.writing-list__meta {
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.045em;
		text-transform: uppercase;
	}

	.writing-list__type {
		color: var(--color-accent);
		font-weight: 700;
	}

	.writing-list h3,
	.writing-list p {
		margin: 0;
	}

	.writing-list h3 {
		font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.625rem);
		line-height: 1.25;
	}

	.writing-list h3 a {
		text-decoration: none;
	}

	.writing-list p {
		max-width: 40rem;
		color: var(--color-text-muted);
	}

	.writing-list__tags {
		margin: var(--space-1) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		list-style: none;
	}

	.writing-list--essay .writing-list__type {
		color: var(--color-text-muted);
		font-family: var(--font-sans);
		font-weight: 650;
		letter-spacing: 0.06em;
	}

	.writing-list--essay h3 {
		font-size: clamp(1.375rem, 1.15rem + 0.7vw, 1.875rem);
	}

	@media (hover: hover) {
		.writing-list h3 a:hover {
			color: var(--color-accent-hover);
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 0.28em;
		}
	}
</style>
