---
import type { WritingEntity, WritingType } from '../../lib/writing';
import LocalizedText from '../LocalizedText.astro';
import WritingList from './WritingList.astro';

interface Props {
	title: string;
	description: string;
	type: WritingType;
	entries: WritingEntity[];
}

const { title, description, type, entries } = Astro.props;
const years = [...new Set(entries.map((entry) => entry.data.date.getFullYear()))];
const labelKey = type === 'research-note' ? 'writing.notes.label' : 'writing.essays.label';
const titleKey = type === 'research-note' ? 'writing.notes.title' : 'writing.essays.title';
const descriptionKey = type === 'research-note' ? 'writing.notes.description' : 'writing.essays.description';
const emptyKey = type === 'research-note' ? 'writing.notes.empty' : 'writing.essays.empty';
---

<div class:list={['page-shell', 'writing-collection', `writing-collection--${type}`]}>
	<a class="context-link" href="/writing"><span aria-hidden="true">←</span> <LocalizedText key="common.backWriting" /></a>

	<header class="page-intro">
		<p class="page-eyebrow"><LocalizedText key={labelKey} /></p>
		<h1 class="page-title"><LocalizedText key={titleKey} /></h1>
		<p class="page-description"><LocalizedText key={descriptionKey} /></p>
	</header>

	{entries.length ? (
		<div class="year-groups">
			{years.map((year) => (
				<section class="year-group" aria-labelledby={`year-${year}`}>
					<h2 id={`year-${year}`}>{year}</h2>
					<WritingList entries={entries.filter((entry) => entry.data.date.getFullYear() === year)} variant={type} />
				</section>
			))}
		</div>
	) : (
		<div class="archive-empty">
			<p><LocalizedText key={emptyKey} /></p>
		</div>
	)}
</div>

<style>
	.writing-collection .page-intro {
		margin-top: var(--space-8);
	}

	.year-groups {
		max-width: var(--layout-prose-max);
		margin-top: clamp(3.5rem, 8vw, 5.5rem);
		display: grid;
		gap: var(--space-16);
	}

	.year-group h2 {
		margin: 0 0 var(--space-4);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 650;
		letter-spacing: 0.08em;
	}
</style>
