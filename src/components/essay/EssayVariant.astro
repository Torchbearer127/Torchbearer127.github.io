---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { SupportedLocale } from '../../i18n/locales.ts';
import type { WritingEntity } from '../../lib/writing.ts';
import SeriesNavigation from '../writing/SeriesNavigation.astro';
import EssayToc from './EssayToc.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	entity: WritingEntity;
	locale: SupportedLocale;
	Content: AstroComponentFactory;
	headings: Heading[];
	active: boolean;
	series?: WritingEntity[];
}

const { entity, locale, Content, headings, active, series = [] } = Astro.props;
const variant = entity.variants[locale]!;
const ccscPart = entity.data.series?.id === 'ccsc-2026'
	? ['其一', '其二', '其三'][entity.data.series.order - 1]
	: undefined;
const ccscSubject = variant.title.split(' · ').slice(1).join(' · ');
---

<section
	class="essay-variant"
	data-essay-variant={locale}
	data-title={variant.title}
	data-description={variant.description}
	hidden={!active}
	aria-hidden={active ? 'false' : 'true'}
>
	<p class="content-fallback-notice" data-content-fallback-notice hidden></p>
	<div class="essay-mobile-tools">
		<EssayToc headings={headings} mobile />
	</div>
	<div class="essay-grid">
		<EssayToc headings={headings} compact={entity.data.series?.id === 'ccsc-2026'} />
		<section class="article-paper">
			<article class:list={['essay-article', {'essay-article--research-note': entity.type === 'research-note'}]} data-essay-article lang={locale}>
				<header class="essay-article__header">
					<h1>{ccscPart ? <>
						<span class="essay-article__title-line">{entity.data.series!.title} {ccscPart}：</span>
						<span class="essay-article__title-line">{ccscSubject}</span>
					</> : variant.title}</h1>
					<p class="essay-article__meta">
						<span class="essay-article__author">执炬人 / <span translate="no">Torchbearer127</span></span><br />
						<span>{variant.description}</span>
						{!ccscPart && <><br /><time datetime={entity.data.date.toISOString()}>{entity.data.dateLabel ?? entity.data.date.getFullYear()}</time></>}
					</p>
				</header>
				<SeriesNavigation entity={entity} entries={series} locale={locale} />
				<Content />
			</article>
		</section>
		<div class="essay-right-rail" aria-hidden="true"></div>
	</div>
</section>
