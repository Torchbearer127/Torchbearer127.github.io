---
import type { GalleryItem } from '../../data/gallery';
import LocalizedContent from '../LocalizedContent.astro';
import GalleryImage from './GalleryImage.astro';
interface Props { items: GalleryItem[] }
const { items } = Astro.props;
// Two landscape photographs pair with one full-height portrait without cropping.
const isTriptych = items.length === 3 && items.every((item, index) =>
	item.width && item.height && (index < 2 ? item.width > item.height : item.height > item.width)
);
---

{items.length > 0 && (
	<div class:list={['gallery', { 'gallery--single': items.length === 1, 'gallery--pair': items.length === 2, 'gallery--triptych': isTriptych }]}>
		{items.map((item, index) => (
			<figure class="gallery-item">
				<GalleryImage item={item} loading={index === 0 ? 'eager' : 'lazy'} />
				<figcaption><LocalizedContent id={`gallery-${item.id}-caption`} values={item.caption} /></figcaption>
			</figure>
		))}
	</div>
)}

<style>
	.gallery { margin-top: clamp(3rem, 7vw, 5rem); columns: 3; column-gap: clamp(1.5rem, 2.5vw, 2rem); }
	.gallery--single { max-width: 52rem; columns: 1; }
	.gallery--pair { columns: 2; }
	.gallery-item { margin: 0 0 clamp(1.75rem, 4vw, 2.5rem); break-inside: avoid; }
	figcaption { margin-top: 0.65rem; color: var(--color-text-muted); font-size: 0.85rem; line-height: 1.65; overflow-wrap: anywhere; }
	@media (max-width: 64rem) { .gallery:not(.gallery--single) { columns: 2; } }
	@media (max-width: 40rem) { .gallery:not(.gallery--single) { columns: 1; } }

	/* Archive composition only; the About teaser has its own curated order. */
	.gallery--triptych {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
		gap: var(--space-8) clamp(1.5rem, 3vw, 3rem);
		align-items: start;
	}
	.gallery--triptych .gallery-item { min-width: 0; margin: 0; }
	.gallery--triptych .gallery-item:nth-child(2) { grid-column: 1; grid-row: 2; }
	.gallery--triptych .gallery-item:nth-child(3) { grid-column: 2; grid-row: 1 / span 2; }
	@media (max-width: 40rem) {
		.gallery--triptych { display: block; }
		.gallery--triptych .gallery-item + .gallery-item { margin-top: var(--space-8); }
	}
</style>
