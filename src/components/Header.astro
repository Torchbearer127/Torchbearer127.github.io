---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/+$/, '');
const navigation = [
	{ href: '/writing', label: 'Writing' },
	{ href: '/notes', label: 'Notes' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/about', label: 'About' },
];
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="site-identity" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
			<span class="site-identity__mark" aria-hidden="true"></span>
			<span>执炬人</span>
		</a>

		<nav class="site-nav" id="primary-navigation" aria-label="Primary" data-header-proximity>
			<ul>
				{navigation.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={currentPath === href ? 'page' : undefined} data-proximity>
							{label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="site-controls">
			<ThemeToggle />
			<button
				class="nav-toggle"
				type="button"
				data-nav-toggle
				aria-expanded="false"
				aria-controls="primary-navigation"
				aria-label="打开主导航"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path class="nav-toggle__line nav-toggle__line--top" d="M5 8h14" />
					<path class="nav-toggle__line nav-toggle__line--bottom" d="M5 16h14" />
				</svg>
			</button>
		</div>
	</div>
</header>

<script>
	const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const navPanel = document.querySelector<HTMLElement>('#primary-navigation');
	const desktopNavigation = window.matchMedia('(min-width: 48rem)');

	const isNavigationOpen = () => navToggle?.getAttribute('aria-expanded') === 'true';

	const setNavigationOpen = (open: boolean, restoreFocus = false) => {
		if (!navToggle || !navPanel) return;

		navToggle.setAttribute('aria-expanded', String(open));
		navToggle.setAttribute('aria-label', open ? '关闭主导航' : '打开主导航');
		navPanel.toggleAttribute('data-open', open);

		if (!open && restoreFocus) navToggle.focus();
	};

	navToggle?.addEventListener('click', () => {
		setNavigationOpen(!isNavigationOpen());
	});

	navPanel?.addEventListener('click', (event) => {
		if ((event.target as Element).closest('a')) setNavigationOpen(false);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && isNavigationOpen() && !desktopNavigation.matches) {
			setNavigationOpen(false, true);
		}
	});

	desktopNavigation.addEventListener('change', (event) => {
		if (event.matches) setNavigationOpen(false);
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid var(--color-border-subtle);
		background: var(--color-canvas);
	}

	.site-header__inner {
		width: min(100%, var(--layout-page-max));
		margin-inline: auto;
		padding-right: max(var(--layout-gutter), env(safe-area-inset-right));
		padding-left: max(var(--layout-gutter), env(safe-area-inset-left));
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			"identity controls"
			"nav nav";
		align-items: center;
	}

	.site-identity {
		grid-area: identity;
		width: fit-content;
		min-height: var(--header-height-mobile);
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		color: var(--color-text-strong);
		font-size: 1rem;
		font-weight: 650;
		letter-spacing: 0.01em;
		text-decoration: none;
	}

	.site-identity__mark {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--color-ember);
	}

	.site-controls {
		grid-area: controls;
		display: flex;
		align-items: center;
		gap: var(--space-1);
	}

	.nav-toggle {
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		display: none;
		place-items: center;
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
	}

	:global(html.js) .nav-toggle {
		display: inline-grid;
	}

	.nav-toggle svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 1.75;
	}

	.nav-toggle__line {
		transform-origin: center;
		transition: transform var(--motion-normal) var(--ease-standard);
	}

	.nav-toggle[aria-expanded="true"] .nav-toggle__line--top {
		transform: translateY(4px) rotate(45deg);
	}

	.nav-toggle[aria-expanded="true"] .nav-toggle__line--bottom {
		transform: translateY(-4px) rotate(-45deg);
	}

	.site-nav {
		grid-area: nav;
		min-width: 0;
		border-top: 1px solid var(--color-border-subtle);
	}

	:global(html.js) .site-nav {
		display: none;
	}

	:global(html.js) .site-nav[data-open] {
		display: block;
	}

	.site-nav ul {
		margin: 0;
		padding: var(--space-2) 0 var(--space-3);
		display: grid;
		list-style: none;
	}

	.site-nav a {
		position: relative;
		min-height: 2.75rem;
		padding-inline: var(--space-2);
		display: flex;
		align-items: center;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
	}

	.site-nav a[aria-current="page"] {
		color: var(--color-text-strong);
		font-weight: 650;
	}

	:global(:root[data-theme="light"]) .site-nav a[aria-current="page"] {
		color: var(--color-accent);
	}

	.site-nav a[aria-current="page"]::after {
		content: "";
		position: absolute;
		inset-inline-start: var(--space-2);
		bottom: 0.25rem;
		width: 1.5rem;
		height: 2px;
		background: var(--color-ember);
	}

	.nav-toggle:active {
		background: var(--color-surface-active);
	}

	@media (hover: hover) {
		.site-identity:hover,
		.site-nav a:hover {
			color: var(--color-accent-hover);
		}

		.site-nav a:hover:not([aria-current="page"]) {
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 0.3em;
		}

		.nav-toggle:hover {
			border-color: var(--color-border-control);
			background: var(--color-accent-soft);
			color: var(--color-accent-hover);
		}
	}

	@media (min-width: 48rem) {
		.site-header__inner {
			min-height: var(--header-height);
			grid-template-columns: minmax(12rem, 1fr) auto auto;
			grid-template-areas: "identity nav controls";
			gap: var(--space-8);
		}

		.site-identity {
			min-height: var(--header-height);
		}

		.site-nav,
		:global(html.js) .site-nav {
			border-top: 0;
			display: block;
		}

		.site-nav ul {
			padding: 0;
			display: flex;
			align-items: center;
			gap: var(--space-6);
		}

		.site-nav a {
			min-height: var(--header-height);
			padding-inline: 0;
			font-size: 0.875rem;
		}

		.site-nav a[aria-current="page"]::after {
			inset-inline: 0;
			bottom: 0;
			width: auto;
		}

		.nav-toggle,
		:global(html.js) .nav-toggle {
			display: none;
		}
	}
</style>
